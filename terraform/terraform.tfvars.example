# Example Terraform Variables for GCP Infrastructure
# Copy to terraform.tfvars and customize with your Google Cloud project details:
#   cp terraform.tfvars.example terraform.tfvars

project_id       = "your-gcp-project-id"
region           = "us-central1"
cluster_name     = "portfolio-cluster"
network_name     = "portfolio-vpc"
enable_autopilot = true

# Optional: If omitted, a unique name like warrenmac-resume-<project_id>-<random> will be generated
# resume_bucket_name = "warrenmac-resume-storage"
