# Template for Gemini API Secret
# Apply via CLI to avoid committing credentials:
# kubectl create secret generic gemini-api-key \
#   --namespace=portfolio \
#   --from-literal=apiKey="YOUR_GEMINI_API_KEY"

apiVersion: v1
kind: Secret
metadata:
  name: gemini-api-key
  namespace: portfolio
type: Opaque
stringData:
  apiKey: "YOUR_GEMINI_API_KEY_HERE"


---
# Template for the contact form's Resend credentials
# Apply via CLI to avoid committing credentials or your inbox address:
# kubectl create secret generic resend-api-key \
#   --namespace=portfolio \
#   --from-literal=apiKey="YOUR_RESEND_API_KEY" \
#   --from-literal=toEmail="you@gmail.com"

apiVersion: v1
kind: Secret
metadata:
  name: resend-api-key
  namespace: portfolio
type: Opaque
stringData:
  apiKey: "YOUR_RESEND_API_KEY_HERE"
  toEmail: "YOUR_INBOX@gmail.com"


---
# Template for app-level secrets (both keys optional)
# Apply via CLI to avoid committing credentials:
# kubectl create secret generic portfolio-app \
#   --namespace=portfolio \
#   --from-literal=resumeSyncToken="$(openssl rand -hex 32)"
#   # add --from-literal=siteAccessPassword=... only if ENABLE_PASSWORD_GATE=true

apiVersion: v1
kind: Secret
metadata:
  name: portfolio-app
  namespace: portfolio
type: Opaque
stringData:
  resumeSyncToken: "GENERATE_WITH_openssl_rand_hex_32"
