# Local Environment Configuration (.env)
# For running locally on macOS host (e.g. uvicorn main:app) or `docker run --env-file .env`
# Keep values UNQUOTED: docker --env-file passes quotes through literally.

# Gemini API Key (optional for basic health check, required for live LLM responses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Storage Backend: "local" (reads frontend PDF) or "gcs" (production Google Cloud Storage)
STORAGE_BACKEND=local
LOCAL_RESUME_PATH=app/frontend/warren-mcdonald-resume.pdf

# MLflow Tracking (pointing to OrbStack MLflow LoadBalancer service)
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=portfolio-agent-local


# Contact form email delivery via Resend (https://resend.com); form returns 503 if unset
# FROM must be on a domain verified in Resend; TO is the inbox that receives inquiries
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio Contact <contact@warrenmac.com>
